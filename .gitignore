.DS_Store

# Swift and Xcode build products. Preview builds intentionally stay in .noindex.
.build/
.build.noindex/
.build.noindex*/
.clean-build.noindex*/
DerivedData/
.swiftpm/xcode/package.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate

# Local runtime state must never enter source control.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.key
*.p12
*.p8
*.pem
.env
.env.*
.netrc

# Machine-local assistant sessions/settings are not project source.
/.codex/
/.claude/

# Generated private/public staging is recreated by fail-closed tooling.
.runtime.noindex/
.staging.noindex/
PublicExport.noindex/
